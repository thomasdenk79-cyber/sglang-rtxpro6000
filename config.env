# Pennyroyal Engine — zentrale Laufzeit-Konfiguration (einzige Wahrheit).
# Wird von pennyroyal.sh und der systemd-Unit gelesen.
IMAGE=localhost/qwen38-nvfp4-kv:3.1.2
CONTAINER=pennyroyal
PORT=30000
HOST_BIND=127.0.0.1
MODEL_DIR=/srv/ai/models/Swift-1.5-Qwen3.8-Flash-Next-NVFP4-FP8PLE
CACHE_ROOT=/srv/ai/cache/pennyroyal
GPU_CDI=nvidia.com/gpu=GPU-780d3589-9811-40ec-db66-93a9146697f3
MEMORY_LIMIT=78g
KV_TOKEN_CAP=1500000
CONTEXT_LENGTH=524288
MEM_FRACTION_STATIC=0.98
MAX_RUNNING_REQUESTS=16
MAX_QUEUED_REQUESTS=32
SERVED_MODEL_NAME=local-blackwell-swift15
# Prompt-/Debug-Logging: 0 aus, 1 Metadaten, 2 vollständige Payloads (JSON ins Engine-Log)
LOG_REQUESTS_LEVEL=2
STOP_TIMEOUT=180
HEALTH_TIMEOUT=1200
