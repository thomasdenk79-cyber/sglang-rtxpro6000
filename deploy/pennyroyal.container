[Unit]
Description=Pennyroyal Qwen3.8 Flash-Next v3.0.0 (Podman, RTX PRO 6000 Blackwell)
After=network-online.target
Wants=network-online.target
ConditionPathExists=/srv/ai/models/RadixArk-Qwen3.8-Flash-Next-NVFP4/config.json

[Container]
Image=ghcr.io/jpezzulli/sglang-rtxpro6000@sha256:fd26ba8d3ce001bb6e4b865236e1b69f7f790b94fb7fe1c32aa81799f4fe338c
ContainerName=pennyroyal
Network=llm-inference.network
User=1000:1000
AddDevice=nvidia.com/gpu=GPU-780d3589-9811-40ec-db66-93a9146697f3
PublishPort=127.0.0.1:8001:8001
ShmSize=16g
Ulimit=memlock=-1:-1
SecurityLabelDisable=true
PodmanArgs=--security-opt=seccomp=unconfined
Volume=/srv/ai/pennyroyal/config/config:/config:ro
Volume=/srv/ai/models:/models:ro
Volume=/srv/ai/cache/pennyroyal:/cache:U,Z
Volume=/srv/ai/nixl/pennyroyal:/nixl:U,Z
Environment=TARGET_MODEL=/models/RadixArk-Qwen3.8-Flash-Next-NVFP4
Environment=CACHE_BASE=/cache
Environment=NIXL_STORAGE_BASE=/nixl
Environment=NIXL_CONFIG=/config/nixl-posix-frspec.toml
Environment=PENNY_PLE_BACKEND=ram
# c16 benchmark profile: 16 admitted requests, 67 recurrent-state slots,
# and reduced static fraction to leave room for the larger Mamba pool.
Environment=MAX_RUNNING_REQUESTS=16
Environment=MAX_MAMBA_CACHE_SIZE=67
Environment=MAX_QUEUED_REQUESTS=32
Environment=PENNY_MEM_FRACTION=0.947
Environment=TP_SIZE=1
Environment=SGLANG_MM_PREPROCESS_DEVICE=cpu
Environment=SGLANG_FORWARD_UNKNOWN_TOOLS=true
Environment=FLASHINFER_GDN_FP16_ACCUM_MMA=1
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=0
Exec=exec bash /config/start-flash-next-frspec.sh
HealthCmd=python3 -c "import urllib.request; raise SystemExit(0 if urllib.request.urlopen('http://127.0.0.1:8001/health', timeout=8).status == 200 else 1)"
HealthInterval=30s
HealthTimeout=30s
HealthRetries=6
HealthStartPeriod=900s

[Service]
# SGLang can exit with status 0 after a fatal scheduler OOM; always recover.
Restart=always
RestartSec=60
TimeoutStartSec=3600
TimeoutStopSec=180

[Install]
WantedBy=default.target
